+    }
+    if(drones){ImGui::SeparatorText("Drone broadcast add-ons");ImGui::Text("DJI: %s | Wi-Fi Remote ID: %s",data.dji_enabled?"enabled":"off",data.rid_enabled?"enabled":"off");if(ImGui::Button("Inspect Drones"))ui.page=Page::Drones;}
+}
